# -----------------------------------------------------------------------------
# SignalBridge environment variables
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
# -----------------------------------------------------------------------------

# Which data source the backend reads from.
#   local     = read JSON files from fixtures/ (no cloud needed — default)
#   firestore = read/write Google Firestore (needs GOOGLE_CLOUD_PROJECT + auth)
DATA_BACKEND=local

# The fake company we run the demo as.
TENANT_ID=buildx-demo

# --- Gemini / Google AI (only needed to run the ADK agent) ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Use the AI Studio API key path (not Vertex). Keep this FALSE for the hackathon demo.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Models are tried in order; if one is out of free quota we fall through to the
# next, so a single exhausted model never breaks the app.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest

# --- Google Cloud (only needed for Firestore / deployment) ---
# Our Firebase project: signalbridge-e6545
GOOGLE_CLOUD_PROJECT=
# If you run the local Firestore emulator, point to it here (e.g. localhost:8080).
# Leave empty to use the real cloud Firestore.
FIRESTORE_EMULATOR_HOST=

# Weather + news + Gemini triage scan, run by the API on a timer. 0 turns it off.
SIGNAL_SCAN_INTERVAL_SECONDS=900
